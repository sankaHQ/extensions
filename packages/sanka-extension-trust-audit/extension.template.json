{
  "commands": [
    "apply",
    "plan",
    "scan"
  ],
  "distribution": {
    "executable": "sanka-extension-trust-audit",
    "name": "sanka-extension-trust-audit",
    "version": "0.1.0a1"
  },
  "id": "sanka/trust-audit",
