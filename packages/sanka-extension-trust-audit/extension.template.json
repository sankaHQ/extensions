      {"kind": "file", "value": "pom.xml"},
      {"kind": "file", "value": "build.gradle"},
      {"kind": "file", "value": "build.gradle.kts"},
      {"kind": "file", "value": "mix.exs"},
      {"kind": "file_suffix", "value": ".pem"},
      {"kind": "file_suffix", "value": ".crt"},
      {"kind": "file_suffix", "value": ".jks"},
      {"kind": "language", "value": "go"},
      {"kind": "language", "value": "java"},
