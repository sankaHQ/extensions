{
  "schema_version": "sanka-extension-manifest/v2",
  "kind": "migration",
  "id": "sanka/php-to-fastapi",
  "version": "0.1.0a1",
  "protocol_version": "sanka-extension/v1",
  "distribution": {
    "name": "sanka-extension-php-to-fastapi",
    "version": "0.1.0a1",
    "executable": "sanka-extension-php-to-fastapi"
  },
  "commands": [
    "scan",
    "plan",
    "apply",
    "test",
    "verify"
  ],
  "targets": [
    "fastapi"
  ],
  "runtime": {
    "sanka_cli": ">=0.2.12,<0.4"
  },
  "match": {
    "all": [
      {
        "kind": "file",
        "value": "sanka-php.json"
      }
    ],
    "any": []
  },
  "wheels": []
}
