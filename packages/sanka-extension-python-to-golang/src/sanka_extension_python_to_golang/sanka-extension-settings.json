{
  "schema_version": "sanka-extension-settings/v1",
  "display": {
    "name": {
      "en": "Python to Go",
      "ja": "Python から Go"
    },
    "description": {
      "en": "Scan detects the source. Choose the Go router in the target list and destination database here.",
      "ja": "Scan で移行元を検出します。ターゲット一覧で Go ルーターを選び、ここで移行先データベースを設定します。"
    }
  },
  "settings": [
    {
      "id": "source_framework",
      "stage": "plan",
      "type": "choice",
      "default": "auto",
      "label": {
        "en": "Source framework",
        "ja": "移行元フレームワーク"
      },
      "choices": [
        {
          "value": "auto",
          "label": {
            "en": "Auto-detect from the Python entrypoint",
            "ja": "Python エントリーポイントから自動検出"
          }
        },
        {
          "value": "python-drf",
          "label": {
            "en": "Django REST Framework",
            "ja": "Django REST Framework"
          }
        },
        {
          "value": "python-fastapi",
          "label": {
            "en": "FastAPI",
            "ja": "FastAPI"
          }
        },
        {
          "value": "python-flask",
          "label": {
            "en": "Flask",
            "ja": "Flask"
          }
        }
      ],
      "advanced": true
    },
    {
      "id": "source_file",
      "stage": "plan",
      "type": "path",
      "default": null,
      "label": {
        "en": "Python entrypoint (relative to this project)",
        "ja": "Python エントリーポイント（プロジェクトからの相対パス）"
      },
      "optional": true,
      "description": {
        "en": "Leave empty to detect the application entrypoint from Django settings or a unique Flask/FastAPI application.",
        "ja": "空欄の場合は Django の設定、または一意の Flask/FastAPI アプリからエントリーポイントを検出します。"
      },
      "advanced": true
    },
    {
      "id": "database_layer",
      "stage": "plan",
      "type": "choice",
      "default": "auto",
      "label": {
        "en": "Destination database",
        "ja": "移行先データベース"
      },
      "choices": [
        {
          "value": "auto",
          "label": {
            "en": "Same as detected source",
            "ja": "検出した移行元と同じ種類"
          }
        },
        {
          "value": "none",
          "label": {
            "en": "No database conversion",
            "ja": "データベース変換なし"
          }
        },
        {
          "value": "pgx",
          "label": {
            "en": "PostgreSQL — pgx and Goose",
            "ja": "PostgreSQL — pgx と Goose"
          }
        },
        {
          "value": "sqlite",
          "label": {
            "en": "SQLite — database/sql and Goose",
            "ja": "SQLite — database/sql と Goose"
          }
        }
      ]
    },
    {
      "id": "source_database",
      "stage": "plan",
      "type": "choice",
      "default": "auto",
      "label": {
        "en": "Source database",
        "ja": "移行元データベース"
      },
      "description": {
        "en": "Detected from Django settings or SQLAlchemy connection configuration. Override only when the source connection is dynamic.",
        "ja": "Django の設定または SQLAlchemy の接続設定から検出します。接続設定が動的な場合のみ指定してください。"
      },
      "when": {
        "database_layer": [
          "auto",
          "pgx",
          "sqlite"
        ]
      },
      "choices": [
        {
          "value": "auto",
          "label": {
            "en": "Auto-detect",
            "ja": "自動検出"
          }
        },
        {
          "value": "sqlite",
          "label": {
            "en": "SQLite",
            "ja": "SQLite"
          }
        },
        {
          "value": "postgresql",
          "label": {
            "en": "PostgreSQL",
            "ja": "PostgreSQL"
          }
        }
      ],
      "advanced": true
    },
    {
      "id": "schema_mode",
      "stage": "plan",
      "type": "choice",
      "default": "empty",
      "label": {
        "en": "Destination schema",
        "ja": "移行先スキーマ"
      },
      "choices": [
        {
          "value": "empty",
          "label": {
            "en": "Empty — generate reviewed schema migrations",
            "ja": "空 — 確認したスキーマ移行を生成"
          }
        },
        {
          "value": "adopt-existing",
          "label": {
            "en": "Existing — validate schema before transfer",
            "ja": "既存 — 転送前にスキーマを検証"
          }
        }
      ],
      "when": {
        "database_layer": "pgx"
      },
      "description": {
        "en": "SQLite supports empty destinations only. Existing PostgreSQL schemas require validation.",
        "ja": "SQLite は空の移行先に対応します。既存の PostgreSQL スキーマは検証が必要です。"
      }
    },
    {
      "id": "models_file",
      "stage": "plan",
      "type": "path",
      "default": null,
      "label": {
        "en": "Python models file (relative to this project)",
        "ja": "Python モデルファイル（プロジェクトからの相対パス）"
      },
      "advanced": true,
      "when": {
        "database_layer": [
          "auto",
          "pgx",
          "sqlite"
        ]
      },
      "optional": true,
      "description": {
        "en": "Leave empty to detect installed Django model modules or the SQLAlchemy model module.",
        "ja": "空欄の場合は Django のモデルモジュールまたは SQLAlchemy のモデルモジュールを検出します。"
      }
    }
  ]
}
