{
  "schema_version": "sanka-extension-settings/v1",
  "display": {
    "name": {
      "en": "Python to Go",
      "ja": "Python から Go"
    },
    "description": {
      "en": "Choose the Go router in the target list; configure the source and database here.",
      "ja": "ターゲット一覧で Go ルーターを選び、ここで移行元とデータベースを設定します。"
    }
  },
  "settings": [
    {
      "id": "source_framework",
      "stage": "plan",
      "type": "choice",
      "default": "auto",
      "label": {
        "en": "Source framework",
        "ja": "移行元フレームワーク"
      },
      "choices": [
        {
          "value": "auto",
          "label": {
            "en": "Auto-detect from the Python entrypoint",
            "ja": "Python エントリーポイントから自動検出"
          }
        },
        {
          "value": "drf",
          "label": {
            "en": "Django REST Framework",
            "ja": "Django REST Framework"
          }
        },
        {
          "value": "fastapi",
          "label": {
            "en": "FastAPI",
            "ja": "FastAPI"
          }
        },
        {
          "value": "flask",
          "label": {
            "en": "Flask",
            "ja": "Flask"
          }
        }
      ]
    },
    {
      "id": "source_file",
      "stage": "plan",
      "type": "path",
      "default": null,
      "label": {
        "en": "Python entrypoint (relative to this project)",
        "ja": "Python エントリーポイント（プロジェクトからの相対パス）"
      },
      "optional": true,
      "description": {
        "en": "Leave empty to detect app.py or one Django URLs module.",
        "ja": "空欄の場合は app.py または Django の URLs モジュールを検出します。"
      }
    },
    {
      "id": "database_layer",
      "stage": "plan",
      "type": "choice",
      "default": "none",
      "label": {
        "en": "Database support",
        "ja": "データベース対応"
      },
      "choices": [
        {
          "value": "none",
          "label": {
            "en": "No database conversion",
            "ja": "データベース変換なし"
          }
        },
        {
          "value": "pgx",
          "label": {
            "en": "PostgreSQL — pgx and Goose",
            "ja": "PostgreSQL — pgx と Goose"
          }
        },
        {
          "value": "sqlite",
          "label": {
            "en": "SQLite — database/sql and Goose",
            "ja": "SQLite — database/sql と Goose"
          }
        }
      ]
    },
    {
      "id": "source_database",
      "stage": "plan",
      "type": "choice",
      "default": "auto",
      "label": {
        "en": "Source database",
        "ja": "移行元データベース"
      },
      "description": {
        "en": "Django is detected from settings. For FastAPI/Flask, Auto follows the target dialect; select SQLite for SQLite to PostgreSQL.",
        "ja": "Djangoは設定から検出します。FastAPI/Flaskの自動検出では移行先と同じ種類を使います。SQLiteからPostgreSQLへの移行ではSQLiteを選択してください。"
      },
      "when": {
        "database_layer": [
          "pgx",
          "sqlite"
        ]
      },
      "choices": [
        {
          "value": "auto",
          "label": {
            "en": "Auto-detect",
            "ja": "自動検出"
          }
        },
        {
          "value": "sqlite",
          "label": {
            "en": "SQLite",
            "ja": "SQLite"
          }
        },
        {
          "value": "postgresql",
          "label": {
            "en": "PostgreSQL",
            "ja": "PostgreSQL"
          }
        }
      ]
    },
    {
      "id": "schema_mode",
      "stage": "plan",
      "type": "choice",
      "default": "empty",
      "label": {
        "en": "Destination schema",
        "ja": "移行先スキーマ"
      },
      "choices": [
        {
          "value": "empty",
          "label": {
            "en": "Empty — generate reviewed schema migrations",
            "ja": "空 — 確認したスキーマ移行を生成"
          }
        },
        {
          "value": "adopt-existing",
          "label": {
            "en": "Existing — validate schema before transfer",
            "ja": "既存 — 転送前にスキーマを検証"
          }
        }
      ],
      "when": {
        "database_layer": "pgx"
      },
      "description": {
        "en": "SQLite supports empty destinations only. Existing PostgreSQL schemas require validation.",
        "ja": "SQLite は空の移行先に対応します。既存の PostgreSQL スキーマは検証が必要です。"
      }
    },
    {
      "id": "models_file",
      "stage": "plan",
      "type": "path",
      "default": "models.py",
      "label": {
        "en": "Python models file (relative to this project)",
        "ja": "Python モデルファイル（プロジェクトからの相対パス）"
      },
      "advanced": true,
      "when": {
        "database_layer": [
          "pgx",
          "sqlite"
        ]
      }
    }
  ]
}
