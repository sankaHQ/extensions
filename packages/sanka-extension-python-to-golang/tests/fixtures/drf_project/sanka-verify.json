            "price": "1.00"
          }
        ]
      },
      "setup": [
        {
          "method": "POST",
          "path": "/api/orders/",
          "body": {
            "reference": "ORD-1",
            "status": "new",
            "items": [
              {
                "sku": "SKU-A",
