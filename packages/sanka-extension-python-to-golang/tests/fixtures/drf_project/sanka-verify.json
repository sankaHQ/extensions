{
  "db_env": "BENCH_DB_PATH",
  "scenarios": [
    {
      "id": "list-orders",
      "method": "GET",
      "path": "/api/orders/",
      "headers": {
        "Accept": "application/json"
      },
      "expected_source_status": 200,
      "setup": [
        {
          "method": "POST",
          "path": "/api/orders/",
          "body": {
            "reference": "ORD-1",
            "status": "new",
            "items": [
              {
                "sku": "SKU-A",
                "quantity": 2,
                "price": "10.00"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "retrieve-order",
      "method": "GET",
      "path": "/api/orders/1/",
      "headers": {
        "Accept": "application/json"
      },
      "expected_source_status": 200,
      "setup": [
        {
          "method": "POST",
          "path": "/api/orders/",
          "body": {
            "reference": "ORD-1",
            "status": "new",
            "items": [
              {
                "sku": "SKU-A",
                "quantity": 2,
                "price": "10.00"
              }
            ]
          }
        }
      ]
    },
    {
