      "method": "DELETE",
      "path": "/api/orders/1/",
      "headers": {
        "Accept": "application/json"
      },
      "expected_source_status": 204,
      "setup": [
        {
          "method": "POST",
          "path": "/api/orders/",
          "body": {
            "reference": "ORD-1",
            "status": "new",
            "items": [
              {
                "sku": "SKU-A",
                "quantity": 2,
                "price": "10.00"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "duplicate-reference",
      "method": "POST",
      "path": "/api/orders/",
      "headers": {
        "Accept": "application/json"
      },
      "expected_source_status": 400,
      "body": {
        "reference": "ORD-1",
        "items": []
      },
      "setup": [
        {
          "method": "POST",
          "path": "/api/orders/",
          "body": {
            "reference": "ORD-1",
            "status": "new",
            "items": [
              {
                "sku": "SKU-A",
