          }
        ]
      }
    },
    {
      "id": "update-order",
      "method": "PATCH",
      "path": "/api/orders/1/",
      "headers": {
        "Accept": "application/json"
      },
      "expected_source_status": 200,
      "body": {
        "status": "paid",
        "memo": "updated"
      },
      "setup": [
        {
          "method": "POST",
          "path": "/api/orders/",
          "body": {
            "reference": "ORD-1",
            "status": "new",
            "items": [
              {
                "sku": "SKU-A",
                "quantity": 2,
                "price": "10.00"
              }
            ]
          }
        }
      ]
    },
    {
